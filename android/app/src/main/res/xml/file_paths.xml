<?xml version="1.0" encoding="utf-8"?>
<!-- Scoped to the two app-private directories Capacitor's file chooser can
     write a camera capture into. The template default (external-path ".")
     made the whole of shared storage addressable through this provider. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="my_images" path="Pictures/" />
    <cache-path name="my_cache_images" path="." />
</paths>
